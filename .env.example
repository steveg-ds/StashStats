# Ravelry API Credentials
API_USERNAME=your_personal_access_username
API_KEY=your_personal_access_password
RAVELRY_USERNAME=YourRavelryUsername

# Local dev/docker environment variables
SQLITE_DB_PATH=/app/data/stash.db
REDIS_URL=redis://cache:6379/0
DEV_MOCK_ANALYTICS=False

# Host User ID / Group ID for file permissions
UID=1000
GID=1000

# Analytics Auto-Refresh Interval in seconds
ANALYTICS_REFRESH_INTERVAL=30

# Logging level: only log warnings and errors to prevent performance slowness
LOG_LEVEL=WARNING
